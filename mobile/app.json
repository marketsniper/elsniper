{
  "expo": {
    "name": "zanziGo",
    "slug": "karim",
    "owner": "zanzigo.com",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/df409e04-637b-4287-9e58-e99ea1fa521e"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zanzigo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.zanzigo.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "zanziGo utilise la caméra pour scanner les QR codes des véhicules et des colis.",
        "NSPhotoLibraryUsageDescription": "zanziGo accède à vos photos pour joindre les preuves de ramassage et de livraison des colis."
      }
    },
    "android": {
      "package": "com.zanzigo.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF0E4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E2733",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 100
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "zanziGo partage votre position pendant vos livraisons pour informer l'expéditeur de l'avancée du colis."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "zanziGo utilise la caméra pour scanner les QR codes des véhicules et des colis."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "zanziGo accède à vos photos pour joindre les preuves de ramassage et de livraison des colis."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/web"
    },
    "extra": {
      "eas": {
        "projectId": "df409e04-637b-4287-9e58-e99ea1fa521e"
      }
    }
  }
}
