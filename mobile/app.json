{
  "expo": {
    "name": "zanziGo",
    "slug": "zanzigo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zanzigo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.zanzigo.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "zanziGo utilise la caméra pour scanner les QR codes des véhicules et des colis.",
        "NSPhotoLibraryUsageDescription": "zanziGo accède à vos photos pour joindre les preuves de ramassage et de livraison des colis."
      }
    },
    "android": {
      "package": "com.zanzigo.app",
      "adaptiveIcon": {
        "backgroundColor": "#CCFBF1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D9488",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "zanziGo utilise la caméra pour scanner les QR codes des véhicules et des colis."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "zanziGo accède à vos photos pour joindre les preuves de ramassage et de livraison des colis."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
