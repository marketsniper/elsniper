# ===== zanziGo backend — variables d'environnement =====
# Copier en .env et adapter. AUCUN secret réel ne doit être commité.

# Serveur
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://zanzigo:zanzigo@localhost:5432/zanzigo

# ===== Authentification =====
# Secret de signature des JWT — OBLIGATOIRE et fort en production
# (ex. openssl rand -hex 32). Défaut dev : "dev-secret-zanzigo" (warning au démarrage).
JWT_SECRET=
# Durée de vie des jetons (syntaxe jsonwebtoken). Défaut : 30d
JWT_EXPIRES_IN=30d
# Clé des routes équipe (header X-Admin-Key). Défaut dev : "dev-admin-key".
# En production : valeur forte aléatoire, différente de tout secret de dev.
ADMIN_API_KEY=
# Mode pilote : renvoie le code OTP dans la réponse API (tests sans vrais SMS).
# Ne JAMAIS laisser à 1 avec de vrais utilisateurs.
OTP_EXPOSE_DEV_CODE=0

# ===== Métier =====
COMMISSION_RATE=0.15
TEAM_WHATSAPP_NUMBER=+255000000000
# Prix touriste (USD) d'une place en taxi partagé (les locaux voient le prix TZS du chauffeur)
RIDES_USD_PER_SEAT=17

# ===== Pesapal (paiements) =====
# Sans PESAPAL_CONSUMER_KEY/SECRET, le service tourne en mode STUB (dev).
# PESAPAL_ENV : sandbox (https://cybqa.pesapal.com/pesapalv3) ou live (https://pay.pesapal.com/v3)
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# URL publique (HTTPS) de notification de paiement (IPN), enregistrée au démarrage
PESAPAL_IPN_URL=
# URL de retour du client après paiement
PESAPAL_CALLBACK_URL=

# ===== Stockage S3 compatible (Cloudflare R2 recommandé) =====
# Sans S3_BUCKET + S3_ACCESS_KEY_ID + S3_SECRET_ACCESS_KEY, fallback dev :
# fichiers écrits dans backend/uploads/ et servis sur /uploads.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Endpoint S3 compatible (ex. R2 : https://<account_id>.r2.cloudflarestorage.com)
S3_ENDPOINT=
# Région ("auto" pour R2)
S3_REGION=auto
# URL publique de lecture des fichiers (domaine public du bucket)
S3_PUBLIC_URL=
