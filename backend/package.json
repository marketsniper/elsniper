{
  "name": "zanzigo-backend",
  "version": "1.0.0",
  "description": "API zanziGo — courses taxi et livraison de colis à Zanzibar",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "smoke-test": "node scripts/smoke-test.js",
    "test": "NODE_ENV=test DATABASE_URL=postgres://zanzigo:zanzigo@localhost:5432/zanzigo_test node --test --test-concurrency=1 'test/*.test.js'"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
