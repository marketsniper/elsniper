
# Version web (export Expo copie dans backend/public/web) : ses assets
# vivent sous un dossier nomme node_modules - ne pas les ignorer.
!backend/public/web/
!backend/public/web/**

# Hooks graphify locaux (non commites : le binaire graphify absent des
# conteneurs neufs ferait echouer chaque hook — les instructions utiles
# vivent dans CLAUDE.md et .claude/skills/, eux commites).
.claude/settings.json

# graphify : fichiers de travail locaux (le graphe lui-même, lui, est commité)
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_ast.json
graphify-out/.graphify_extract.json
graphify-out/.graphify_detect.json
graphify-out/.graphify_semantic.json
